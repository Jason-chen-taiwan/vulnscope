{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vulnscope",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Production D1. vulnscope-v2 replaced the original `vulnscope`
      // (9cdd7df2…) on 2026-07-08: that instance degraded to ~70% failure on
      // microsecond PK lookups — likely a wedged import session consuming the
      // Durable Object's resources — with no user-facing reset. Fresh seed,
      // 10/10 health probes. Old DB retained as fallback; delete once stable.
      "database_name": "vulnscope-v2",
      "database_id": "9491304c-e35b-4c68-8f39-14dd0f7ba5f3"
    }
  ],
  "kv_namespaces": [
    {
      // @opennextjs/cloudflare incremental cache — makes unstable_cache a
      // real cross-isolate cache (per-isolate memory was effectively always
      // cold on Workers, exposing every heavy query to every request).
      "binding": "NEXT_INC_CACHE_KV",
      "id": "fce4ad43539b4af8b02ab39f1680cb0a"
    }
  ]
}
