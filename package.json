{
  "name": "@vulnscope/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "db:start": "./scripts/pg.sh start",
    "db:stop": "./scripts/pg.sh stop",
    "db:psql": "./scripts/pg.sh psql",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node node_modules/drizzle-kit/bin.cjs migrate",
    "ingest:kev": "node node_modules/tsx/dist/cli.mjs scripts/ingest/kev.ts",
    "ingest:osv": "node --max-old-space-size=4096 node_modules/tsx/dist/cli.mjs scripts/ingest/osv.ts",
    "ingest:epss": "node node_modules/tsx/dist/cli.mjs scripts/ingest/epss.ts",
    "ingest:all": "pnpm ingest:kev && pnpm ingest:osv --ecosystem=npm,PyPI,Maven,Go,RubyGems,Packagist,crates.io,NuGet,Hex,Hackage,Debian,Alpine,Bitnami && pnpm ingest:epss",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.47.1",
    "@renovatebot/pep440": "^1.0.0",
    "@types/yauzl": "^2.10.3",
    "adm-zip": "^0.5.16",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.36.0",
    "next": "^15.0.0",
    "next-intl": "^4.12.0",
    "p-limit": "^6.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.6.3",
    "server-only": "^0.0.1",
    "undici": "^7.0.0",
    "yauzl": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.5.8",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
