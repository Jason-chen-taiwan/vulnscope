# --- Required ---
# Postgres connection. The default points at the local cluster started by
# `pnpm db:start` (Homebrew) or `docker compose up -d` (Docker variant).
DATABASE_URL=postgres://vulnscope:vulnscope@127.0.0.1:55432/vulnscope

# --- Optional: SEO / canonical URL ---
# Used in sitemap.xml and robots.txt. Set to your public URL in production.
# NEXT_PUBLIC_SITE_URL=https://vulnscope.dev

# --- Optional: admin ---
# When set, POST /api/v1/admin/refresh accepts ?token=... or
# Authorization: Bearer ... headers. Without it, the endpoint is loopback-only.
# ADMIN_TOKEN=

# --- Optional: scheduler ---
# Disable the in-process daily refresh entirely (useful in tests / CI).
# SCHEDULER_DISABLED=1

# --- Optional: IndexNow ---
# Pings Bing / Yandex / Naver / Seznam / Yep when CVE records change
# so new pages get crawled in hours instead of weeks.
# Get a key at https://www.bing.com/webmasters → Settings → API access,
# or generate any 8-128 char hex string (it's identity-only). The key
# MUST also be exposed as ${NEXT_PUBLIC_SITE_URL}/${INDEXNOW_KEY}.txt
# (file content = the key itself). Unset = scheduler skips IndexNow.
# INDEXNOW_KEY=your-32-char-hex-key

# --- Optional: analytics ---
# Plausible (or a self-host fork) — privacy-friendly, no cookies.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vulnscope.dev
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Optional: ad slots (off by default) ---
# Set to "true" to render the sidebar ad slot. With NEXT_PUBLIC_CARBON_SRC,
# the slot loads Carbon Ads' approved script; without, it shows a sponsor
# placeholder so you can validate layout without third-party scripts.
# NEXT_PUBLIC_ADS_ENABLED=true
# NEXT_PUBLIC_CARBON_SRC=//cdn.carbonads.com/carbon.js?serve=...&placement=...

# --- Optional: newsletter signup ---
# Point at any form action URL (Buttondown / ConvertKit / Substack / your own).
# NEXT_PUBLIC_NEWSLETTER_URL=https://buttondown.email/api/emails/embed-subscribe/vulnscope
