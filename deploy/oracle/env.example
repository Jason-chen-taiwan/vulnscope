# Copy to deploy/oracle/.env on the VM and fill in.
# DATABASE_URL is injected by docker-compose.oracle.yml — do NOT set it here.

# Postgres password for the in-VM database (any strong string).
POSTGRES_PASSWORD=change-me-to-something-strong

# Public URL of your site (used in sitemap.xml / robots.txt / canonical).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Protects POST /api/v1/admin/refresh. Generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- Optional (copy from your current fly.io secrets if you use them) ---
# INDEXNOW_KEY=
# RESEND_API_KEY=
# Polar / better-auth / etc. — bring over whatever fly secrets you had set.
